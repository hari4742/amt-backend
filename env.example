# Application Settings
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/amt_backend
# For SQLite (development): DATABASE_URL=sqlite:///./amt_backend.db

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600  # 100MB in bytes
ALLOWED_AUDIO_FORMATS=["wav", "mp3", "flac", "m4a", "ogg"]

# Audio Processing
SAMPLE_RATE=44100
MAX_AUDIO_DURATION=600  # 10 minutes in seconds

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Logging
LOG_LEVEL=INFO 